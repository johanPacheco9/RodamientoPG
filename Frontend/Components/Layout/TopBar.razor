@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider

@if (showMenu)
{
    <div class="position-fixed top-0 start-0 w-100 h-100"
         style="z-index:1040"
         @onclick="CloseMenu">
    </div>
}

<nav class="navbar navbar-expand shadow-sm px-4 py-0 sticky-top bg-white border-bottom border-light-subtle"
     style="height:70px; z-index:1050;">

    <div class="container-fluid p-0">

        <div class="text-secondary m-0 fw-semibold" style="font-size:.9rem;">
            <i class="bi bi-geo-alt me-2 text-warning fs-5"></i>
            @Ciudad
        </div>

        <div class="d-flex align-items-center gap-4">

            <div class="text-success small fw-medium d-flex align-items-center gap-2"
                 style="font-size:.85rem;">
                <span class="pulse-green"></span>
                Servidor Conectado
            </div>

            <div class="position-relative">

                <button class="btn btn-link text-decoration-none text-dark fw-semibold border-0 p-0"
                        @onclick="ToggleMenu">

                    @UserName

                    <i class="bi @(showMenu ? "bi-chevron-up" : "bi-chevron-down") ms-1"></i>

                </button>

                @if (showMenu)
                {
                    <div class="dropdown-menu dropdown-menu-end show shadow"
                         style="display:block;
                                position:absolute;
                                right:0;
                                top:calc(100% + 10px);
                                min-width:220px;
                                z-index:1051;">
                        
                        <hr class="dropdown-divider"/>

                        <a class="dropdown-item py-2 text-danger"
                           href="/PLogOut/CerrarSesion"
                           target="_top">

                            <i class="bi bi-box-arrow-right me-2"></i>

                            Cerrar Sesión

                        </a>

                    </div>
                }

            </div>

        </div>

    </div>

</nav>

@code {

    private bool showMenu;

    private string UserName = "";
    private string Ciudad = "";

    protected async override Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        UserName = auth.User.Identity?.Name ?? "Usuario";

        // Cargar ciudad desde tu servicio
        // Ciudad = _parametro.Ciudad;

        Ciudad = "Melgar";
    }

    private void ToggleMenu()
    {
        showMenu = !showMenu;
    }

    private void CloseMenu()
    {
        showMenu = false;
    }

}