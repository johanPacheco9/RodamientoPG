@page "/descuentos"
@using Domain.Models
@rendermode InteractiveServer
@inject ILogger<Descuento> Logger

<PageTitle>Descuentos</PageTitle>

<h3>Descuentos</h3>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="AbrirModalCrear">
        <i class="bi bi-plus-circle"></i> Nuevo Descuento
    </button>
</div>

@if (_cargando)
{
    <p><em>Cargando...</em></p>
}
else if (_descuentos is null || _descuentos.Count == 0)
{
    <div class="alert alert-info">No hay descuentos registrados.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Desde</th>
                <th>Hasta</th>
                <th>Porcentaje</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var descuento in _descuentos)
            {
                <tr>
                    <td>@descuento.Id</td>
                    <td>@descuento.Desde.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@descuento.Hasta.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@descuento.Porcentaje.ToString("0.##")%</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => AbrirModalEditar(descuento)">
                            <i class="bi bi-pencil"></i> Editar
                        </button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => AbrirModalEliminar(descuento)">
                            <i class="bi bi-trash"></i> Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@* ===================== MODAL CREAR / EDITAR ===================== *@
@if (_mostrarModalForm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <EditForm Model="_descuentoForm" FormName="DescuentoForm" OnValidSubmit="GuardarDescuento">
                    <DataAnnotationsValidator />

                    <div class="modal-header">
                        <h5 class="modal-title">@(_editandoId is null ? "Nuevo Descuento" : "Editar Descuento")</h5>
                        <button type="button" class="btn-close" @onclick="CerrarModalForm"></button>
                    </div>

                    <div class="modal-body">
                        <ValidationSummary class="text-danger" />

                        @if (!string.IsNullOrEmpty(_mensajeError))
                        {
                            <div class="alert alert-danger">@_mensajeError</div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Desde</label>
                            <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="_descuentoForm.Desde" />
                            <ValidationMessage For="() => _descuentoForm.Desde" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Hasta</label>
                            <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="_descuentoForm.Hasta" />
                            <ValidationMessage For="() => _descuentoForm.Hasta" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Porcentaje (%)</label>
                            <InputNumber class="form-control" @bind-Value="_descuentoForm.Porcentaje" step="0.01" />
                            <ValidationMessage For="() => _descuentoForm.Porcentaje" />
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModalForm" disabled="@_guardando">
                            Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary" disabled="@_guardando">
                            @if (_guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Guardar
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@* ===================== MODAL CONFIRMAR ELIMINAR ===================== *@
@if (_mostrarModalEliminar && _descuentoAEliminar is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar Eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalEliminar"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_mensajeError))
                    {
                        <div class="alert alert-danger">@_mensajeError</div>
                    }
                    <p>
                        ¿Está seguro que desea eliminar el descuento del
                        <strong>@_descuentoAEliminar.Desde.ToString("dd/MM/yyyy")</strong> al
                        <strong>@_descuentoAEliminar.Hasta.ToString("dd/MM/yyyy")</strong>
                        (<strong>@_descuentoAEliminar.Porcentaje.ToString("0.##")%</strong>)?
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalEliminar" disabled="@_guardando">
                        Cancelar
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarEliminar" disabled="@_guardando">
                        @if (_guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>
}