@page "/Clases"
@using Domain.Models.Vehiculos
@using Infrastructure.Services.TiposVehiculos
@inject NavigationManager NavigationManager
@inject TiposService TiposService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer  

<div class="container-fluid py-3">
    <div class="card shadow-sm border-0 rounded-3">
        <!-- Encabezado Principal -->
        <div class="card-header bg-white py-3 border-0">
            <div class="row align-items-center g-2">
                <div class="col-12 col-md-4">
                    <h5 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-car-front-fill text-primary"></i> Clases de Vehículos
                    </h5>
                </div>
                <div class="col-12 col-md-5">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" id="buscarTexto" name="searchString"
                               class="form-control bg-light border-start-0 ps-0" @bind="_textoBusqueda"
                               placeholder="Buscar por código o nombre..." 
                               @onkeyup="@(e => { if (e.Key == "Enter") BuscarClaseVehiculo(); })"/>
                        <button type="button" @onclick="BuscarClaseVehiculo" class="btn btn-primary btn-sm px-3">
                            Buscar
                        </button>
                    </div>
                </div>
                <div class="col-12 col-md-3 text-md-end">
                    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 shadow-sm px-3" 
                            @onclick="() => MostrarModal(false)">
                        <i class="bi bi-plus-lg"></i>
                        <span>Nueva Clase</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Cuerpo con Tabla Modernizada -->
        <div class="card-body p-0 position-relative">
            @if (_isLoading)
            {
                <div class="table-loading-overlay">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }

            <div class="table-responsive" style="min-height: 250px;">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th class="ps-3" style="width: 100px;">ID</th>
                            <th style="width: 120px;">CÓDIGO</th>
                            <th>CLASE DE VEHÍCULO</th>
                            <th class="text-center" style="width: 100px;">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_listTipoVehiculos == null || !_listTipoVehiculos.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                    <span>No se encontraron registros.</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var clase in ObtenerItemsPaginados())
                            {
                                <tr @onclick="() => SeleccionarFila(clase)" 
                                    style="cursor: pointer;" 
                                    class="@((_claseSeleccionada?.Id == clase.Id) ? "table-active" : "")">
                                    <td class="ps-3 text-muted fw-semibold">#@clase.Id</td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-2 py-1 fs-6 font-monospace">
                                            @clase.Codigo
                                        </span>
                                    </td>
                                    <td class="fw-semibold text-dark">@clase.Nombre</td>
                                    <td class="text-center" @onclick:stopPropagation="true">
                                        <button type="button" class="btn btn-outline-danger btn-sm border-0 rounded-circle p-1" 
                                                title="Eliminar registro"
                                                @onclick="() => Elimi_Clas(clase.Id)">
                                            <i class="bi bi-trash fs-6"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Footer con Paginación -->
            @if (TotalPaginas > 1)
            {
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center p-3 bg-light border-top gap-2">
                    <small class="text-muted">
                        Mostrando <b>@(((PaginaActual - 1) * TamanoPagina) + 1)</b> a <b>@(Math.Min(PaginaActual * TamanoPagina, _listTipoVehiculos.Count))</b> de <b>@_listTipoVehiculos.Count</b> registros
                    </small>
                    <nav aria-label="Paginacion">
                        <ul class="pagination pagination-sm m-0">
                            <li class="page-item @(PaginaActual == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => CambiarPagina(PaginaActual - 1)">Anterior</button>
                            </li>
                            @for (int i = 1; i <= TotalPaginas; i++)
                            {
                                var paginaAsignada = i;
                                <li class="page-item @(PaginaActual == paginaAsignada ? "active" : "")">
                                    <button class="page-link" @onclick="() => CambiarPagina(paginaAsignada)">@paginaAsignada</button>
                                </li>
                            }
                            <li class="page-item @(PaginaActual == TotalPaginas ? "disabled" : "")">
                                <button class="page-link" @onclick="() => CambiarPagina(PaginaActual + 1)">Siguiente</button>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Modernizado -->
@if (_mostrarModal)
{
    <div class="liq-overlay"></div>
    <div class="liq-modal-wrap">
        <div class="liq-modal shadow-lg rounded-3">
            <div class="liq-modal-head bg-dark text-white p-3">
                <span class="fw-bold d-flex align-items-center gap-2">
                    <i class="bi @(_esModoEditar ? "bi-pencil-square" : "bi-plus-circle")"></i>
                    @(_esModoEditar ? "Editar Clase de Vehículo" : "Agregar Clase de Vehículo")
                </span>
                <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
            </div>
            <div class="liq-modal-body p-4 bg-white">
                @if (_tipoVehiculo != null)
                {
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label text-secondary small fw-bold">ID</label>
                            <input type="text" class="form-control form-control-sm bg-light" @bind="_tipoVehiculo.Id" readonly placeholder="Auto">
                        </div>
                        
                        <div class="col-md-3">
                            <label class="form-label text-secondary small fw-bold">CÓDIGO</label>
                            <input type="number" class="form-control form-control-sm fw-bold" @bind="_tipoVehiculo.Codigo" readonly="@_esModoEditar">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-secondary small fw-bold">NOMBRE CLASE</label>
                            <input type="text" maxlength="40" class="form-control form-control-sm fw-bold" @bind="_tipoVehiculo.Nombre" placeholder="Ej: Automóvil, Camión...">
                        </div>
                    </div>
                }
                
                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3" @onclick="CerrarModal">
                        Cancelar
                    </button>
                    <button type="button" class="btn btn-sm btn-success text-white px-4 d-flex align-items-center gap-1"
                            @onclick="() => _esModoEditar ? Actualizar(_tipoVehiculo) : Agregar()">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>@(_esModoEditar ? "Guardar Cambios" : "Registrar Clase")</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .liq-overlay { 
        position: fixed; 
        top: 0; left: 0; 
        width: 100vw; height: 100vh; 
        background: rgba(15, 23, 42, 0.55); 
        backdrop-filter: blur(2px);
        z-index: 1040; 
    }
    .liq-modal-wrap { 
        position: fixed; 
        top: 50%; left: 50%; 
        transform: translate(-50%, -50%); 
        z-index: 1050; 
        width: 90%; 
        max-width: 580px; 
    }
    .liq-modal { 
        background: #fff; 
        overflow: hidden; 
    }
    .liq-modal-head { 
        display: flex; 
        justify-content: space-between; 
        align-items: center; 
    }
    .table-loading-overlay {
        position: absolute; 
        top: 0; left: 0; 
        width: 100%; height: 100%;
        background: rgba(255, 255, 255, 0.7); 
        z-index: 5; 
        display: flex;
        justify-content: center; 
        align-items: center;
    }
</style>

@code {
    private bool _mostrarModal = false;
    private string? _textoBusqueda; 
    private TipoVehiculo _tipoVehiculo = new();
    private List<TipoVehiculo> _listTipoVehiculos = [];
    private bool _esModoEditar = false;
    private TipoVehiculo? _claseSeleccionada;
    private bool _isLoading = false;

    // Control de paginación
    private int PaginaActual { get; set; } = 1;
    private int TamanoPagina { get; set; } = 10;
    private int TotalPaginas => (int)Math.Ceiling((double)_listTipoVehiculos.Count / TamanoPagina);

    protected async override Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        _isLoading = true;
        try
        {
            var clases = await TiposService.GetAll();
            _listTipoVehiculos = clases?.ToList() ?? new List<TipoVehiculo>();
            PaginaActual = 1;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar clases de vehículos: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SeleccionarFila(TipoVehiculo item)
    {
        _claseSeleccionada = item;
        _tipoVehiculo = item;
        _esModoEditar = true;
        _mostrarModal = true;
    }

    private async Task BuscarClaseVehiculo()
    {
        if (string.IsNullOrWhiteSpace(_textoBusqueda))
        {
            await CargarDatos();
            return;
        }

        if (int.TryParse(_textoBusqueda.Trim(), out int codigoNumerico))
        {
            _isLoading = true;
            
            string? nombreClase = await TiposService.GetNameByCode(codigoNumerico);

            if (nombreClase != null)
            {
                _listTipoVehiculos = new List<TipoVehiculo>
                {
                    new TipoVehiculo 
                    { 
                        Id = codigoNumerico, 
                        Codigo = codigoNumerico, 
                        Nombre = nombreClase 
                    }
                };
            }
            else
            {
                _listTipoVehiculos = new List<TipoVehiculo>();
            }
            
            PaginaActual = 1;
            _isLoading = false;
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", new object[] { "Por favor, ingresa un código numérico válido para buscar." });
        }
    }

    private async Task Agregar()
    {
        if (string.IsNullOrWhiteSpace(_tipoVehiculo.Nombre))
        {
            await JSRuntime.InvokeVoidAsync("alert", new object[] { "El nombre de la clase es obligatorio." });
            return;
        }

        var result = await TiposService.Add(_tipoVehiculo);
        await CerrarModal();
        await CargarDatos();
    }

    private async Task Elimi_Clas(int id)
    {
        bool confirmationResult = await JSRuntime.InvokeAsync<bool>("confirm", new object[] { "¿Está seguro de eliminar esta clase de vehículo permanentemente?" });
        
        if (confirmationResult)
        {
            await TiposService.Delete(id); 
            await CargarDatos();
        }
    }

    private async Task Actualizar(TipoVehiculo claseVehiculo)
    {
        if (string.IsNullOrWhiteSpace(claseVehiculo.Nombre))
        {
            await JSRuntime.InvokeVoidAsync("alert", new object[] { "El nombre de la clase no puede estar vacío." });
            return;
        }

        var count = await TiposService.Update(claseVehiculo);

        if (count > 0)
        {
            await CerrarModal();
            await CargarDatos();
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", new object[] { "No se pudieron guardar los cambios de la clase." });
        }
    }

    public void MostrarModal(bool modoEditar)
    {
        _esModoEditar = modoEditar;
        
        if (_esModoEditar && _claseSeleccionada != null)
        {
            _tipoVehiculo = _claseSeleccionada;
        }
        else
        {
            _tipoVehiculo = new TipoVehiculo { Codigo = 0 }; 
        }
        
        _mostrarModal = true;
    }

    private async Task CerrarModal()
    {
        _mostrarModal = false;
        _claseSeleccionada = null; 
        await InvokeAsync(StateHasChanged);
    }

    private IEnumerable<TipoVehiculo> ObtenerItemsPaginados()
    {
        return _listTipoVehiculos.Skip((PaginaActual - 1) * TamanoPagina).Take(TamanoPagina);
    }

    private void CambiarPagina(int nuevaPagina)
    {
        if (nuevaPagina >= 1 && nuevaPagina <= TotalPaginas)
        {
            PaginaActual = nuevaPagina;
        }
    }
}