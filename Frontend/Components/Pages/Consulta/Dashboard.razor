                                                    <strong>@v.Vigencia</strong>
                                                    <span
                                                        class="text-muted small">($@v.TotalVigencia.ToString("N0"))</span>
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- 🚀 El valor monetario ya no se digita, se totaliza sumando las deudas del rango en el backend -->

                        <div class="col-12">
                            <label class="form-label">Observaciones / Sustento Legal</label>
                            <textarea class="form-control" rows="3"
                                      placeholder="Escriba los motivos o el número de radicado externo..."
                                      @bind="resolObj.Observaciones"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CerrarModal">Cancelar</button>
                    <button class="btn btn-warning btn-sm" @onclick="Agregar_resol">
                        <i class="bi bi-file-earmark-check"></i> Generar resolución consecutiva
                    </button>
                </div>
            </div>
        </div>
    </div>
}



@* ── Modal Crear Acuerdo de Pago ── *@
@if (_mostrarModalCrearAcuerdo)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold text-primary">
                        <i class="bi bi-file-earmark-plus me-2"></i>Nuevo Acuerdo de Pago — Placa @_estadoCuenta.Placa
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalCrearAcuerdo"></button>
                </div>
                <div class="modal-body">
                    
                    <h6 class="fw-semibold text-secondary mb-2">1. Seleccione las vigencias a financiar:</h6>
                    
                    @* Selección interna de vigencias en la tabla *@
                    <div class="table-responsive border rounded mb-3" style="max-height: 220px; overflow-y: auto;">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th style="width: 40px;" class="text-center">
                                        <input type="checkbox" class="form-check-input" 
                                               @onchange="ToggleSeleccionarTodasVigenciasAcuerdo" 
                                               checked="@_vigenciasAcuerdo.All(v => v.Seleccionado)" />
                                    </th>
                                    <th>Vigencia</th>
                                    <th class="text-end">Capital</th>
                                    <th class="text-end">Interés</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!_vigenciasAcuerdo.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-3">
                                            No hay vigencias pendientes disponibles para financiar.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in _vigenciasAcuerdo)
                                    {
                                        var capitalVigencia = item.VigenciaForm.Conceptos.Sum(c => c.Valor);
                                        var interesVigencia = item.VigenciaForm.Conceptos.Sum(c => c.ValorInteres);

                                        <tr>
                                            <td class="text-center">
                                                <input type="checkbox" class="form-check-input" 
                                                       @bind="item.Seleccionado" 
                                                       @bind:after="RecalcularSimulacionAcuerdo" />
                                            </td>
                                            <td class="fw-bold">@item.VigenciaForm.Vigencia</td>
                                            <td class="text-end">@capitalVigencia.ToString("C0")</td>
                                            <td class="text-end text-danger">@interesVigencia.ToString("C0")</td>
                                            <td class="text-end fw-semibold">@item.VigenciaForm.TotalVigencia.ToString("C0")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    @* Resumen financiero de la selección *@
                    <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded border mb-3">
                        <span class="text-muted small">Total seleccionado para financiar:</span>
                        <span class="fs-5 fw-bold text-success">@_totalFinanciarModal.ToString("C0")</span>
                    </div>

                    <h6 class="fw-semibold text-secondary mb-2">2. Parametrización de las cuotas:</h6>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Número de Cuotas (*)</label>
                            <input type="number" class="form-control" min="1" max="60" 
                                   @bind="_nuevoAcuerdo.NumeroCuotas" 
                                   @bind:event="oninput" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Valor Cuota Inicial (Opcional)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" min="0" step="1000" 
                                       @bind="_nuevoAcuerdo.ValorCuotaInicial" 
                                       @bind:event="oninput" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Fecha de Suscripción</label>
                            <input type="date" class="form-control" @bind="_nuevoAcuerdo.FechaSuscripcion" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Proceso Coactivo Asociado</label>
                            <select class="form-select" @bind="_nuevoAcuerdo.ProcesoId">
                                <option value="">-- Sin proceso (Cobro Persuasivo) --</option>
                                @foreach (var p in coactivosList)
                                {
                                    <option value="@p.Id">Proceso No. @p.NumeroProceso</option>
                                }
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Observaciones</label>
                            <textarea class="form-control" rows="2" placeholder="Notas sobre el acuerdo..." @bind="_nuevoAcuerdo.Observaciones"></textarea>
                        </div>
                    </div>

                    @* Proyección rápida *@
                    @if (_nuevoAcuerdo.NumeroCuotas > 0 && _totalFinanciarModal > 0)
                    {
                        var saldoDiferir = _totalFinanciarModal - _nuevoAcuerdo.ValorCuotaInicial;
                        var cuotaPromedio = saldoDiferir > 0 ? saldoDiferir / _nuevoAcuerdo.NumeroCuotas : 0;

                        <div class="alert alert-info mt-3 mb-0 py-2 d-flex justify-content-between align-items-center">
                            <span>Saldo a diferir: <strong>@saldoDiferir.ToString("C0")</strong></span>
                            <span>Cuota aprox.: <strong class="fs-6">@cuotaPromedio.ToString("C0")</strong></span>
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="CerrarModalCrearAcuerdo">Cancelar</button>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="GuardarAcuerdoPago" disabled="@_guardandoAcuerdo">
                        @if (_guardandoAcuerdo)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Procesando...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-lg me-1"></i>
                            <span>Crear Acuerdo</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}









<script>
    window.downloadFileFromStream = async (fileName, streamRef) => {
        const arrayBuffer = await streamRef.arrayBuffer();
        const blob = new Blob([arrayBuffer]);
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = fileName;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    };
</script>
