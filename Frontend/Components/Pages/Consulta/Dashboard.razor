                            <th>Vence</th>
                            <th>Pago</th>
                            <th class="text-end">Capital</th>
                            <th class="text-end">Interés</th>
                            <th class="text-end">Total</th>
                            <th>Estado</th>
                        </tr>
                        </thead>
