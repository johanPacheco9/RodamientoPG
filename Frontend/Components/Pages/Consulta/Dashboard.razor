                                <td>@cuota.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                <td>@(cuota.FechaPago?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td class="text-end">@cuota.ValorCuota.ToString("C0")</td>
                                <td class="text-end">@cuota.InteresFinanciacion.ToString("C0")</td>
