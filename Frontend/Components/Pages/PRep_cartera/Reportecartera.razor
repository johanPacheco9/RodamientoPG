@page "/ReporteCartera"
@using Infrastructure.Services.Reportes
@using Infrastructure.Services.Reportes.Responses
@rendermode InteractiveServer
@inject ReportesManager ReportesManager
@inject IJSRuntime JsRuntime

<div class="container-fluid px-4 py-3">
    <!-- Pestañas de Navegación -->
    <ul class="nav nav-tabs mb-4" id="reportTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link @(_tabActiva == 1 ? "active fw-bold text-primary" : "text-secondary")" 
                    @onclick="() => SeleccionarTab(1)">
                <i class="bi bi-calendar3 me-2"></i>Cartera Por Vigencias
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_tabActiva == 2 ? "active fw-bold text-primary" : "text-secondary")" 
                    @onclick="() => SeleccionarTab(2)">
                <i class="bi bi-car-front me-2"></i>Deudas Por Clase Vehículo
            </button>
        </li>
    </ul>

    @if (_tabActiva == 1)
    {
        <!-- PESTAÑA 1: CARTERA POR VIGENCIAS -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body p-3" style="border-left: 4px solid #112366;">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h5 class="mb-0 fw-bold text-dark text-uppercase" style="font-size: 15px;">
                            Informe Deudas Por Vigencia
                        </h5>
                        <small class="text-muted">Estado del "Debido Cobrar" global consolidado por año gravable</small>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm text-white" style="background-color: #112366;" 
                                @onclick="CargarCarteraPorVigencias" disabled="@_isLoadingVigencias">
                            @if (_isLoadingVigencias)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            }
                            else
                            {
                                <i class="bi bi-search me-1"></i>
                            }
                            Consultar Cartera
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="Imprimir" disabled="@(!_itemsVigencias.Any())">
                            <i class="bi bi-printer me-1"></i> Imprimir Reporte
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0" style="font-size: 13px;">
                    <thead class="table-light">
                        <tr style="border-bottom: 2px solid #112366;">
                            <th class="ps-3 py-2">VIGENCIA</th>
                            <th class="py-2 text-end">DERECHO TRÁNSITO</th>
                            <th class="py-2 text-end">IMPUESTO CARGA</th>
                            <th class="py-2 text-end">ESTAMPILLAS</th>
                            <th class="py-2 text-end">COSTAS</th>
                            <th class="py-2 text-end">INTERESES</th>
                            <th class="pe-3 py-2 text-end fw-bold">TOTAL DEUDA</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_isLoadingVigencias)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="spinner-border text-primary" role="status"></div>
                                    <div class="text-muted mt-2">Procesando registros de cartera por vigencia...</div>
                                </td>
                            </tr>
                        }
                        else if (!_itemsVigencias.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-info-circle display-6"></i>
                                    <p class="mt-2 mb-0 fw-medium">No hay datos de cartera consultados.</p>
                                    <small>Haga clic en "Consultar Cartera" para procesar el debido cobrar.</small>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in _itemsVigencias)
                            {
                                <tr>
                                    <td class="ps-3 py-2 fw-bold text-dark">@item.Vigencia</td>
                                    <td class="text-end text-secondary">@item.ValorRodamiento.ToString("C0")</td>
                                    <td class="text-end text-secondary">@item.ValorCarga.ToString("C0")</td>
                                    <td class="text-end text-secondary">@item.ValorEstampillas.ToString("C0")</td>
                                    <td class="text-end text-secondary">@item.ValorCostas.ToString("C0")</td>
                                    <td class="text-end text-danger">@item.ValorInteres.ToString("C0")</td>
                                    <td class="pe-3 text-end fw-bold text-dark">@item.ValorTotal.ToString("C0")</td>
                                </tr>
                            }
                            <tr class="table-light fw-bold border-top" style="border-bottom: 2px solid #dee2e6;">
                                <td class="ps-3 py-2 text-uppercase">Total General</td>
                                <td class="text-end">@_itemsVigencias.Sum(x => x.ValorRodamiento).ToString("C0")</td>
                                <td class="text-end">@_itemsVigencias.Sum(x => x.ValorCarga).ToString("C0")</td>
                                <td class="text-end">@_itemsVigencias.Sum(x => x.ValorEstampillas).ToString("C0")</td>
                                <td class="text-end">@_itemsVigencias.Sum(x => x.ValorCostas).ToString("C0")</td>
                                <td class="text-end text-danger">@_itemsVigencias.Sum(x => x.ValorInteres).ToString("C0")</td>
                                <td class="pe-3 text-end text-success fs-6">@_itemsVigencias.Sum(x => x.ValorTotal).ToString("C0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (_tabActiva == 2)
    {
        <!-- PESTAÑA 2: CARTERA POR CLASE DE VEHÍCULO -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body p-3" style="border-left: 4px solid #112366;">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h5 class="mb-0 fw-bold text-dark text-uppercase" style="font-size: 15px;">
                            Informe Deudas Por Clase de Vehículo
                        </h5>
                        <small class="text-muted">Estado del "Debido Cobrar" global discriminado por tipo de vehículo</small>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm text-white" style="background-color: #112366;" 
                                @onclick="CargarCarteraPorClase" disabled="@_isLoadingClases">
                            @if (_isLoadingClases)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            }
                            else
                            {
                                <i class="bi bi-search me-1"></i>
                            }
                            Consultar Cartera
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="Imprimir" disabled="@(!_itemsClases.Any())">
                            <i class="bi bi-printer me-1"></i> Imprimir Reporte
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0" style="font-size: 13px;">
                    <thead class="table-light">
                        <tr style="border-bottom: 2px solid #112366;">
                            <th class="ps-3 py-2">CLASE DE VEHÍCULO</th>
                            <th class="py-2 text-end">DERECHO TRÁNSITO</th>
                            <th class="py-2 text-end">IMPUESTO CARGA</th>
                            <th class="py-2 text-end">ESTAMPILLAS</th>
                            <th class="py-2 text-end">COSTAS</th>
                            <th class="py-2 text-end">INTERESES</th>
                            <th class="pe-3 py-2 text-end fw-bold">TOTAL DEUDA</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_isLoadingClases)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="spinner-border text-primary" role="status"></div>
                                    <div class="text-muted mt-2">Procesando registros por clase de vehículo...</div>
                                </td>
                            </tr>
                        }
                        else if (!_itemsClases.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-info-circle display-6"></i>
                                    <p class="mt-2 mb-0 fw-medium">No hay datos consultados.</p>
                                    <small>Haga clic en "Consultar Cartera" para obtener la información.</small>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in _itemsClases)
                            {
                                <tr>
                                    <td class="ps-3 py-2 fw-bold text-dark">@item.ClaseVehiculo</td>
                                    <td class="text-end text-secondary">@item.ValorRodamiento.ToString("C0")</td>
                                    <td class="text-end text-secondary">@item.ValorCarga.ToString("C0")</td>
                                    <td class="text-end text-secondary">@item.ValorEstampillas.ToString("C0")</td>
                                    <td class="text-end text-secondary">@item.ValorCostas.ToString("C0")</td>
                                    <td class="text-end text-danger">@item.ValorInteres.ToString("C0")</td>
                                    <td class="pe-3 text-end fw-bold text-dark">@item.ValorTotal.ToString("C0")</td>
                                </tr>
                            }
                            <tr class="table-light fw-bold border-top" style="border-bottom: 2px solid #dee2e6;">
                                <td class="ps-3 py-2 text-uppercase">Total General</td>
                                <td class="text-end">@_itemsClases.Sum(x => x.ValorRodamiento).ToString("C0")</td>
                                <td class="text-end">@_itemsClases.Sum(x => x.ValorCarga).ToString("C0")</td>
                                <td class="text-end">@_itemsClases.Sum(x => x.ValorEstampillas).ToString("C0")</td>
                                <td class="text-end">@_itemsClases.Sum(x => x.ValorCostas).ToString("C0")</td>
                                <td class="text-end text-danger">@_itemsClases.Sum(x => x.ValorInteres).ToString("C0")</td>
                                <td class="pe-3 text-end text-success fs-6">@_itemsClases.Sum(x => x.ValorTotal).ToString("C0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private int _tabActiva = 1;
    
    private bool _isLoadingVigencias = false;
    private bool _isLoadingClases = false;
    
    private List<CarteraVigenciaDto> _itemsVigencias = [];
    private List<CarteraClaseVehiculoDto> _itemsClases = [];

    protected override async Task OnInitializedAsync()
    {
        await CargarCarteraPorVigencias();
    }

    private async Task SeleccionarTab(int tabIndex)
    {
        _tabActiva = tabIndex;

        if (_tabActiva == 1 && !_itemsVigencias.Any())
        {
            await CargarCarteraPorVigencias();
        }
        else if (_tabActiva == 2 && !_itemsClases.Any())
        {
            await CargarCarteraPorClase();
        }
    }

    private async Task CargarCarteraPorVigencias()
    {
        _isLoadingVigencias = true;
        try
        {
            _itemsVigencias = await ReportesManager.ObtenerCarteraPorVigencias();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al consultar el debido cobrar por vigencias: {ex.Message}");
        }
        finally
        {
            _isLoadingVigencias = false;
        }
    }

    private async Task CargarCarteraPorClase()
    {
        _isLoadingClases = true;
        try
        {
            _itemsClases = await ReportesManager.ObtenerCarteraPorClaseVehiculo();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al consultar el debido cobrar por clase de vehículo: {ex.Message}");
        }
        finally
        {
            _isLoadingClases = false;
        }
    }

    private async Task Imprimir()
    {
        await JsRuntime.InvokeVoidAsync("window.print");
    }
}