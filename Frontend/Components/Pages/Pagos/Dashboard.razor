@page "/Pagos"
@using Domain.Generics
@using Domain.Models.Recibos.Responses
@using Domain.Responses.Recibo.Enums
@using Frontend.Reportes
@using Infrastructure.Services.Pagos
@using Microsoft.AspNetCore.Components.Web

@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager
@inject HttpClient HttpClient
@rendermode InteractiveServer

<div class="py-2 px-4 text-white shadow-sm" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="d-flex align-items-center justify-content-between max-width-1400 mx-auto">
        <div class="d-flex align-items-center gap-3">
            <div class="p-2 rounded-3" style="background: rgba(255,255,255,0.2);">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                    <rect x="2" y="5" width="20" height="14" rx="2"/>
                    <line x1="2" y1="10" x2="22" y2="10"/>
                </svg>
            </div>
            <h1 class="h5 mb-0 fw-light tracking-tight">Módulo de Pagos</h1>
        </div>
        <div class="px-3 py-1 rounded-pill" style="background: rgba(255,255,255,0.15); font-size: 0.8rem;">
            <span class="d-flex align-items-center gap-2">
                <span class="rounded-circle d-inline-block"
                      style="width: 8px; height: 8px; background-color: @(envia_ws ? "#10b981" : "#f59e0b");"></span>
                WS Estado
            </span>
        </div>
    </div>
</div>

<div class="container-fluid py-4" style="max-width: 1400px;">

    <!-- Buscador -->
    <div class="row align-items-end g-3 mb-4">
        <div class="col-12 col-md-4 col-lg-3">
            <label class="form-label text-uppercase text-muted fw-bold mb-1"
                   style="font-size: 0.7rem; letter-spacing: 0.05em;">Referencia de pago</label>
            <div class="input-group">
                <input type="number" class="form-control form-control-sm" @bind="_reciboIdBusqueda"
                       @bind:event="oninput"
                       @onkeyup="@(async (e) => { if (e.Key == "Enter") await BuscaRecibo(); })"
                       placeholder="Número de recibo..."/>
                <button type="button" class="btn btn-dark btn-sm px-3" @onclick="BuscaRecibo">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                </button>
            </div>
        </div>

        @if (recibo != null && recibo.Id > 0)
        {
            <div class="col-12 col-md d-flex gap-4 justify-content-md-end mt-3 mt-md-0">
                <div>
                    <div class="text-muted" style="font-size: 0.7rem;">ESTADO</div>
                    <div class="d-flex align-items-center gap-2 mt-1">
                        <span class="rounded-circle d-inline-block"
                              style="width: 10px; height: 10px; background-color: @(recibo.Estado == EstadoRecibo.Pagado ? "#10b981" : "#f59e0b");"></span>
                        <span class="fw-bold text-dark small">@recibo.Estado.GetDisplayName()</span>
                    </div>
                </div>
                <div class="border-start ps-4">
                    <div class="text-muted" style="font-size: 0.7rem;">TOTAL SISTEMA</div>
                    <div class="fw-bold text-dark h5 mb-0 mt-1">@recibo.ValorTotalSistema.ToString("C0")</div>
                </div>
            </div>
        }
    </div>

    @if (recibo != null && recibo.Id > 0)
    {
        <!-- Resumen del DTO -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card h-100 shadow-sm border-light-subtle p-3 rounded-3 bg-white">
                    <div class="text-muted text-uppercase fw-bold mb-2" style="font-size: 0.7rem;">Vehículo / Placa</div>
                    <div class="display-6 fw-bold text-dark tracking-wide mb-1" style="font-size: 1.6rem;">
                        @(string.IsNullOrEmpty(recibo.PlacaVehiculo) ? "SIN PLACA" : recibo.PlacaVehiculo.ToUpper())
                    </div>
                    <div class="text-muted small">
                        Vigencias cobradas: 
                        <strong class="text-primary">
                            @if (recibo.Detalles.Any())
                            {
                                @string.Join(", ", recibo.Detalles.Select(d => d.Vigencia).Distinct().OrderBy(v => v))
                            }
                            else
                            {
                                <span>Sin detalles</span>
                            }
                        </strong>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card h-100 shadow-sm border-light-subtle p-3 rounded-3 bg-white">
                    <div class="text-muted text-uppercase fw-bold mb-2" style="font-size: 0.7rem;">Liquidación Base</div>
                    <div class="d-flex justify-content-between mb-1 small">
                        <span class="text-secondary">Capital:</span>
                        <span class="fw-semibold text-dark">@recibo.ValorCapital.ToString("C0")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1 small">
                        <span class="text-secondary">Interés Mora:</span>
                        <span class="fw-semibold text-danger">@recibo.InteresMora.ToString("C0")</span>
                    </div>
                    <div class="d-flex justify-content-between small">
                        <span class="text-secondary">Descuento:</span>
                        <span class="fw-semibold text-success">- @recibo.Descuento.ToString("C0")</span>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card h-100 shadow-sm border-light-subtle p-3 rounded-3 bg-white">
                    <div class="text-muted text-uppercase fw-bold mb-2" style="font-size: 0.7rem;">Recargos Adicionales</div>
                    <div class="d-flex justify-content-between mb-1 small">
                        <span class="text-secondary">Estampillas:</span>
                        <span class="fw-semibold text-dark">@recibo.Estampillas.ToString("C0")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1 small">
                        <span class="text-secondary">Rodamiento:</span>
                        <span class="fw-semibold text-dark">@recibo.ValorRodamiento.ToString("C0")</span>
                    </div>
                    <div class="d-flex justify-content-between small">
                        <span class="text-secondary">Carga Datos:</span>
                        <span class="fw-semibold text-dark">@recibo.ValorCargaDatos.ToString("C0")</span>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card h-100 shadow-sm border-light-subtle p-3 rounded-3 bg-white">
                    <div class="text-muted text-uppercase fw-bold mb-2" style="font-size: 0.7rem;">Consistencia de Valores</div>
                    <div class="h4 fw-bold text-primary mb-1">@recibo.ValorTotalCalculado.ToString("C0")</div>
                    <div class="text-muted small">
                        Estado Integración:
                        <span class="badge @(recibo.EstaCompleto ? "bg-success" : "bg-warning text-dark")">
                            @(recibo.EstaCompleto ? "Consistente" : "Divergencia")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla de Detalles -->
        <div class="card shadow-sm border-0 rounded-4 p-4 mb-4 bg-white">
            <div class="d-flex align-items-center gap-2 mb-3">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#667eea" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                    <line x1="16" y1="13" x2="8" y2="13"/>
                    <line x1="16" y1="17" x2="8" y2="17"/>
                </svg>
                <span class="fw-bold text-secondary small">Conceptos por Vigencia (@recibo.Detalles.Count registros)</span>
            </div>

            @if (recibo.Detalles != null && recibo.Detalles.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Vigencia</th>
                                <th>Concepto</th>
                                <th>ID Cartera</th>
                                <th class="text-end">Valor Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var det in recibo.Detalles)
                            {
                                <tr>
                                    <td><span class="badge bg-secondary">@det.Vigencia</span></td>
                                    <td>@det.Concepto</td>
                                    <td><code>#@det.CarteraId</code></td>
                                    <td class="text-end fw-bold">@det.ValorTotal.ToString("C0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted small mb-0">Este recibo no contiene ítems detallados de vigencias.</p>
            }
        </div>

        <!-- Registro y Acciones -->
        <div class="p-3 bg-light rounded-4 border border-light-subtle">
            <div class="row align-items-end g-3">
                <div class="col-12 col-lg">
                    <label class="form-label text-muted fw-bold mb-1" style="font-size: 0.75rem;">REGISTRO DE EVENTOS Y AUDITORÍA</label>
                    <textarea @bind="mensaje" rows="3" class="form-control bg-white font-monospace small"
                              placeholder="// Historial operativo del recibo actual..."
                              style="font-size: 0.85rem;"></textarea>
                </div>
                <div class="col-12 col-lg-auto d-flex flex-wrap gap-2 justify-content-lg-end">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3 py-2 d-flex align-items-center gap-1"
                            @onclick="GenerarPdf">
                        <span>🖨️ PDF</span>
                    </button>

                    @if (recibo.Estado == EstadoRecibo.Pendiente)
                    {
                        <button type="button" class="btn btn-success btn-sm px-4 py-2 text-white fw-semibold"
                                @onclick="Procesar">
                            ✅ Procesar Pago
                        </button>
                    }

                    @if (recibo.Estado == EstadoRecibo.Pagado)
                    {
                        <button type="button" class="btn btn-danger btn-sm px-4 py-2 fw-semibold" @onclick="Reversar">
                            ⚠️ Reversar Recibo
                        </button>
                    }
                </div>
            </div>
        </div>
    }
    else if (!isLoading && _reciboIdBusqueda > 0)
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <h5 class="text-muted fw-light mb-0">No se encontró información estructurada para el recibo ingresado.</h5>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <h5 class="text-muted fw-light mb-0">Ingresa un número de referencia para comenzar la operación</h5>
        </div>
    }
</div>

@if (mostrarSpinnerModal)
{
    <div class="modal-backdrop fade show" style="z-index: 1060;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1070;">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
            <div class="modal-content shadow border-0 py-3">
                <div class="modal-body text-center">
                    <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;"></div>
                    <h6 class="text-dark fw-bold mb-1">Generando PDF Oficial</h6>
                    <p class="text-muted small mb-0">Compilando recibo de pago, por favor espere...</p>
                </div>
            </div>
        </div>
    </div>
}